{% extends "_base.html.j2" %}
{% block body %}
<header class="masthead">
  <h1>{{ doc.name }}</h1>
  {% if doc.headline %}<p class="headline">{{ doc.headline }}</p>{% endif %}
  {% if doc.contact %}<p class="contact">
    {%- for item in doc.contact %}{% if not loop.first %}{{ separator }}{% endif %}<span class="item">{{ item }}</span>{% endfor -%}
  </p>{% endif %}
</header>
{% for section in doc.sections %}
<section class="section section-{{ section.id }}">
  <h2>{{ section.title }}</h2>
  {% for block in section.blocks %}
  {% if block.kind == "paragraph" %}
  <p class="text">{{ block.text }}</p>
  {% elif block.kind == "bullets" %}
  <ul>{% for item in block.items %}<li>{{ item }}</li>{% endfor %}</ul>
  {% else %}
  <div class="entry">
    <div class="entry-head">
      <span class="entry-title">{{ block.title }}</span>
      {% if block.dates %}<span class="entry-dates">{{ block.dates }}</span>{% endif %}
    </div>
    {% if block.subtitle %}<p class="entry-subtitle">{{ block.subtitle }}</p>{% endif %}
    {% if block.bullets %}<ul>{% for item in block.bullets %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
  </div>
  {% endif %}
  {% endfor %}
</section>
{% endfor %}
{% endblock %}
{% block css %}
.masthead { margin-bottom: 10pt; text-align: {{ style.name_align }}; }
.headline { margin-top: 2pt; font-size: {{ style.body_pt + 1 }}pt; }
.contact { margin-top: 3pt; color: #374151; }
.section { margin-top: 10pt; }
.entry { margin-top: 5pt; break-inside: avoid; }
.entry-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12pt; }
.entry-title { font-weight: 700; }
.entry-dates { white-space: nowrap; color: #374151; }
.entry-subtitle { font-style: italic; color: #374151; }
{% block template_css %}{% endblock %}
{% endblock %}

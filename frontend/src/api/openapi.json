          }
        }
      },
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Establish Session",
        "description": "Called once by the page with its token header. Sets the HttpOnly cookie EventSource\nneeds (EventSource can't send headers), including behind the Vite dev proxy.",
        "operationId": "establish_session_api_session_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
